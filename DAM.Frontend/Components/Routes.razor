@using DAM.Frontend.Features.Auth.Pages
@using DAM.Frontend.Features.Dashboard.Pages
@using DAM.Frontend.Features.Activities.Pages
@using DAM.Frontend.Features.Presence.Pages
@using DAM.Frontend.Features.Invoices.Pages
@using DAM.Frontend.Features.Audit.Pages
@using DAM.Frontend.Features.System.Pages
@using DAM.Frontend.Shared.Components.Layout
@using DAM.Frontend.Shared.Components.UI
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<ThemeInitializer />

<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
                    <MudPaper Elevation="3" Class="pa-8 text-center">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Error" Class="mb-4" />
                        <MudText Typo="Typo.h5" Class="mb-4">Acceso Denegado</MudText>
                        <MudText Class="mb-4">No tienes permisos para acceder a esta página.</MudText>
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   Href="/auth/login">
                            Iniciar Sesión
                        </MudButton>
                    </MudPaper>
                </MudContainer>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <MudContainer Class="text-center mt-16">
                <MudText Typo="Typo.h1">404</MudText>
                <MudText Typo="Typo.h4">Página no encontrada</MudText>
                <MudText Class="mt-4">Lo sentimos, la página que buscas no existe.</MudText>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           Href="/"
                           Class="mt-6">
                    Volver al Inicio
                </MudButton>
            </MudContainer>
        </LayoutView>
    </NotFound>
</Router>