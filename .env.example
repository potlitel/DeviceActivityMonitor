# =====================================================================
# Plantilla de variables de entorno para docker compose
# Copiar a ".env" y ajustar:   cp .env.example .env
# =====================================================================

# URL de la API que consumirá el FRONTEND desde el navegador.
# ⚠️ Debe ser alcanzable DESDE EL NAVEGADOR del usuario (no desde el contenedor).
#    - Dev local:        http://localhost:8081/api
#    - Servidor remoto:  http://<IP-del-servidor>:8081/api
VITE_API_URL=http://localhost:8081/api
